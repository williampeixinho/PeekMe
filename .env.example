# =====================================================================
# PeekMe: configuração. Copie para .env (cp .env.example .env) ou rode
# "sh setup.sh", que pergunta o básico e gera um segredo para você.
# NUNCA publique o seu .env: ele tem senhas e chaves.
# =====================================================================

# ---------- Obrigatório ----------

# Domínio do site, sem https:// (ex.: meu-peekme.duckdns.org ou peekme.exemplo.com).
DOMAIN=meu-peekme.duckdns.org

# Senha que quem quer TRANSMITIR digita no site. Quem assiste não precisa de senha.
HOST_PASSWORD=troque-esta-senha

# Chave e segredo do LiveKit (servidor de vídeo). O nome da chave pode ficar "peekme".
# O segredo precisa ter pelo menos 32 caracteres. Para gerar um:
#   openssl rand -hex 32
LIVEKIT_API_KEY=peekme
LIVEKIT_API_SECRET=gere-um-segredo-longo-com-pelo-menos-32-caracteres

# ---------- Opcional ----------

# Quantas pessoas podem assistir ao mesmo tempo. Cada uma usa ~3 Mbps (720p)
# ou ~5 Mbps (1080p) do UPLOAD da sua internet.
MAX_VIEWERS=5

# Porta interna do site (só muda se a 3077 já estiver em uso na máquina).
APP_PORT=3077

# IP público fixo do servidor. Deixe vazio para descobrir sozinho ao iniciar.
NODE_IP=

# Porta HTTP interna do Caddy. Não precisa abrir no roteador; mude só se a 8780 estiver ocupada.
CADDY_HTTP_PORT=8780

# Fuso horário dos registros do DuckDNS.
TZ=America/Sao_Paulo

# Serviços extras a ligar, separados por vírgula: duckdns, tunnel (ou os dois).
# Deixe vazio se não usar nenhum.
COMPOSE_PROFILES=

# ---------- DuckDNS (perfil "duckdns") ----------
# Domínio grátis que acompanha o IP da sua casa. https://www.duckdns.org
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# ---------- Cloudflare Tunnel (perfil "tunnel") ----------
# Publica o site sem abrir portas (bom para CGNAT/Starlink). Veja o README.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- TURN do Cloudflare ----------
# Necessário quando não dá para abrir portas no roteador (CGNAT, Starlink, 4G/5G).
# Painel do Cloudflare > Realtime > TURN Server > Create.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
