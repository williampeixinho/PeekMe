# Copie para .env (ou rode ./setup.sh, que preenche tudo).
DOMAIN=seunome.duckdns.org
HOST_PASSWORD=troque-esta-senha
LIVEKIT_API_KEY=peekme
LIVEKIT_API_SECRET=gere-um-segredo-longo-com-pelo-menos-32-caracteres
MAX_VIEWERS=5
# Porta interna do site (a 3000 já está em uso na Pi)
APP_PORT=3077

# DuckDNS (opcional). Apague estas linhas se usar outro DDNS.
COMPOSE_PROFILES=duckdns
DUCKDNS_SUBDOMAIN=seunome
DUCKDNS_TOKEN=

# TURN do Cloudflare (opcional; necessário com CGNAT, ex.: Starlink).
# Painel do Cloudflare > Realtime > TURN Server > Create.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
